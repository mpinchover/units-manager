# Where the data lives:
#   demo (default) - fake data in the browser; changes are lost on reload. No server needed.
#   api            - the Flask server in ../server (set API_URL too).
NEXT_PUBLIC_DATA_SOURCE=demo

# API mode only: URL of the Flask API server. Only the Next.js server calls it.
# API_URL=http://127.0.0.1:5001

# Local development against the Firebase Auth emulator (see ../server/README.md)
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
